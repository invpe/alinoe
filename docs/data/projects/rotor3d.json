  "visualization": {
    "code": "const trajectory = data.trajectory || {};\nconst candidate = data.candidate || {};\nconst panels = trajectory.panels || [];\nconst samples = trajectory.samples || [];\n\nroot.innerHTML = `\n  <div style=\"font:14px/1.45 system-ui,sans-serif;color:#171717\">\n    <div style=\"display:grid;grid-template-columns:minmax(280px,1.35fr) minmax(240px,.8fr);gap:18px;align-items:start\">\n      <div>\n        <canvas id=\"rotor-view\" width=\"760\" height=\"460\" style=\"width:100%;background:#f7f7f7;border:1px solid #dedede;border-radius:12px\"></canvas>\n        <div style=\"margin-top:7px;color:#666;font-size:12px\">Winning geometry \u00b7 animated autorotation \u00b7 released from rest</div>\n      </div>\n      <div>\n        <div style=\"font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:#777\">Physical candidate</div>\n        <div style=\"font-size:28px;font-weight:650;margin:3px 0 12px\">${Number(trajectory.descent_time_s || 0).toFixed(3)} s</div>\n        <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:8px 14px;font-size:13px\">\n          <div><b>${Number(trajectory.diameter_mm || 0).toFixed(1)} mm</b><br><span style=\"color:#777\">diameter</span></div>\n          <div><b>${Number(trajectory.mass_g || 0).toFixed(2)} g</b><br><span style=\"color:#777\">estimated PLA mass</span></div>\n          <div><b>${Number(trajectory.max_rpm || 0).toFixed(0)} rpm</b><br><span style=\"color:#777\">maximum autorotation</span></div>\n          <div><b>${Number(trajectory.impact_speed_m_s || 0).toFixed(2)} m/s</b><br><span style=\"color:#777\">impact speed</span></div>\n        </div>\n        <canvas id=\"rotor-chart\" width=\"480\" height=\"250\" style=\"width:100%;margin-top:18px;background:#fff;border:1px solid #e5e5e5;border-radius:10px\"></canvas>\n        <div style=\"margin-top:10px;font-size:12px;color:#666\">The STL is generated from the same candidate geometry used to build the aerodynamic panels.</div>\n      </div>\n    </div>\n  </div>`;\n\nconst view = root.querySelector('#rotor-view');\nconst ctx = view.getContext('2d');\nconst chart = root.querySelector('#rotor-chart');\nconst cctx = chart.getContext('2d');\n\nfunction projectPoint(p, spin) {\n  const cs = Math.cos(spin), sn = Math.sin(spin);\n  const x = p[0] * cs - p[1] * sn;\n  const y = p[0] * sn + p[1] * cs;\n  const z = p[2];\n  const yaw = -0.65, pitch = 0.95;\n  const cy = Math.cos(yaw), sy = Math.sin(yaw);\n  const x1 = x * cy - y * sy;\n  const y1 = x * sy + y * cy;\n  const cp = Math.cos(pitch), sp = Math.sin(pitch);\n  const y2 = y1 * cp - z * sp;\n  const z2 = y1 * sp + z * cp;\n  return [x1, y2, z2];\n}\n\nfunction drawRotor(now) {\n  const w = view.width, h = view.height;\n  ctx.clearRect(0, 0, w, h);\n  ctx.fillStyle = '#f7f7f7'; ctx.fillRect(0, 0, w, h);\n  const spin = now * 0.0017;\n  const scale = Math.min(w, h) * 7.6;\n  const polys = panels.map(poly => {\n    const q = poly.map(p => projectPoint(p, spin));\n    return { q, depth: q.reduce((s,p)=>s+p[2],0)/q.length };\n  }).sort((a,b)=>a.depth-b.depth);\n\n  ctx.save(); ctx.translate(w/2, h/2);\n  for (const poly of polys) {\n    ctx.beginPath();\n    poly.q.forEach((p,i) => {\n      const X = p[0] * scale, Y = -p[1] * scale;\n      if (i === 0) ctx.moveTo(X,Y); else ctx.lineTo(X,Y);\n    });\n    ctx.closePath();\n    ctx.fillStyle = '#d9d9d9'; ctx.fill();\n    ctx.strokeStyle = '#333'; ctx.lineWidth = 1.1; ctx.stroke();\n  }\n  const hubR = Number(trajectory.hub_radius_mm || 8) / 1000 * scale;\n  ctx.beginPath(); ctx.arc(0,0,Math.max(5,hubR),0,Math.PI*2);\n  ctx.fillStyle='#4a4a4a'; ctx.fill();\n  ctx.restore();\n  requestAnimationFrame(drawRotor);\n}\nrequestAnimationFrame(drawRotor);\n\nfunction drawChart() {\n  const w=chart.width,h=chart.height,pad=34;\n  cctx.clearRect(0,0,w,h); cctx.fillStyle='#fff'; cctx.fillRect(0,0,w,h);\n  if (samples.length < 2) return;\n  const tmax = Math.max(...samples.map(s=>s[0]), 0.001);\n  const rpmmax = Math.max(...samples.map(s=>s[8]), 1);\n  cctx.strokeStyle='#ddd'; cctx.lineWidth=1;\n  cctx.beginPath(); cctx.moveTo(pad,12); cctx.lineTo(pad,h-pad); cctx.lineTo(w-10,h-pad); cctx.stroke();\n  cctx.fillStyle='#666'; cctx.font='12px system-ui';\n  cctx.fillText('RPM',7,18); cctx.fillText(`${tmax.toFixed(2)} s`,w-48,h-10);\n  cctx.beginPath();\n  samples.forEach((s,i)=>{\n    const x=pad+(w-pad-12)*(s[0]/tmax);\n    const y=h-pad-(h-pad-18)*(s[8]/rpmmax);\n    if(i===0)cctx.moveTo(x,y);else cctx.lineTo(x,y);\n  });\n  cctx.strokeStyle='#222'; cctx.lineWidth=2; cctx.stroke();\n  cctx.fillStyle='#222'; cctx.fillText(`${rpmmax.toFixed(0)} max`,pad+7,25);\n}\ndrawChart();\n",
